# Secrets and machine-local settings. Keep *.example tracked.
.env
.env.*
!.env.example
!.env.*.example
**/.env

# Python / Django
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
backend/env/
backend/.venv/
.venv/
venv/
env/

# Generated Django output and uploaded files
backend/staticfiles/
backend/media/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Map tiles, DEM rasters, offline image archives, database dumps
*.mbtiles
tileserver/data/dem/**
!tileserver/data/dem/.gitignore
*.tar
*.dump
offline/

# Spreadsheet dumps (not application source)
*.xlsx
*.xls

# Logs
logs/
*.log

# OS and editors
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Synology NAS artifacts
**/@eaDir/
SynologyWorkingDirectory/
.SynologyDrive/
SynologyDrive/
#recycle/
@tmp/
**/#recycle/
**/@tmp/

# Local tool / session state
.grok/
