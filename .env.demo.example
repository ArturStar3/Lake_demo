# Copy to .env.demo and replace every value marked CHANGE_ME.
DEMO_IMAGE=infolake-demo:latest
DEMO_HTTP_PORT=8080
DEMO_DB_PORT=55432
DEMO_PG_VOLUME=infolake_demo_pgdata
DEMO_NETWORK=infolake-integration

# Absolute host paths. Use forward slashes on Windows.
MBTILES_PATH=D:/InfoLakeDemo/maps/map.mbtiles
MEDIA_PATH=D:/InfoLakeDemo/media
DB_DUMP_PATH=D:/InfoLakeDemo/backups/db_dump.dump
# 1 replaces the current demo DB from DB_DUMP_PATH on the next container start.
IS_EMPTY_DB=0

DB_NAME=infolake_demo
DB_USER=infolake
DB_PASSWORD=CHANGE_ME_APPLICATION_DATABASE_PASSWORD
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_ADMIN_PASSWORD
SECRET_KEY=CHANGE_ME_LONG_RANDOM_DJANGO_SECRET
ALLOWED_HOSTS=localhost,127.0.0.1,infolake-demo
FRONTEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

DEMO_MAINTENANCE=0
DEMO_SEED=0
DEMO_AUTO_LOGIN_USERNAME=demo
DEMO_AUTO_LOGIN_PASSWORD=CHANGE_ME_DEMO_SERVICE_PASSWORD
