# Self-contained demonstration appliance.  PostgreSQL, Django, TileServer GL
# and nginx deliberately share this image; the database and user content stay
# outside it in the Compose mounts/volume.
FROM node:20-alpine AS frontend-build

WORKDIR /frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ARG VITE_DEMO_AUTO_LOGIN=true
ARG VITE_DEMO_AUTO_START=true
ENV VITE_DEMO_AUTO_LOGIN=$VITE_DEMO_AUTO_LOGIN \
    VITE_DEMO_AUTO_START=$VITE_DEMO_AUTO_START \
    VITE_API_URL= \
    VITE_TILESERVER_URL=/tiles \
    VITE_ENABLE_HMR=false
RUN npm run build

# The vendor TileServer image is the runtime base, preserving its renderer and
# native dependencies in the self-contained appliance.
FROM maptiler/tileserver-gl:latest

USER root

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/venv/bin:$PATH \
    PGDATA=/var/lib/postgresql/data

RUN export DEBIAN_FRONTEND=noninteractive \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl gnupg wget \
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt noble-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        nginx supervisor postgresql-17 postgresql-client-17 \
        python3 python3-venv python3-dev \
        build-essential libffi-dev libpq-dev \
        gdal-bin libgdal-dev libgeos-dev libproj-dev \
        libcairo2 libpango-1.0-0 libgdk-pixbuf-2.0-0 fonts-dejavu-core \
    && python3 -m venv /opt/venv \
    && apt-get purge -y curl gnupg \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ /app/

COPY tileserver/ /data/
COPY --from=frontend-build /frontend/dist /usr/share/nginx/html
COPY docker/demo-nginx.conf /etc/nginx/conf.d/demo.conf
COPY docker/supervisord-demo.conf /etc/supervisord.conf
COPY docker/demo-entrypoint.sh /usr/local/bin/demo-entrypoint

RUN rm -f /data/data/map.mbtiles \
    && rm -f /etc/nginx/sites-enabled/default \
    && mkdir -p /app/media /app/staticfiles /app/dem_data/glo-90 "$PGDATA" /run/nginx \
    && chown -R postgres:postgres "$PGDATA" \
    && chmod +x /usr/local/bin/demo-entrypoint \
    && sed -i 's/\r$//' /usr/local/bin/demo-entrypoint

EXPOSE 80 5432
VOLUME ["/var/lib/postgresql/data"]
ENTRYPOINT ["demo-entrypoint"]
